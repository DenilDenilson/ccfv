---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MovieCard from '@/components/MovieCard.astro';
import { currentMember } from '@/lib/auth/member';
import { getMemberVote, getPublicVote, getRoundWithCandidates, getVoteCounts, isRoundOpen } from '@/lib/db/repositories';
import { visitorIdentity } from '@/lib/antiabuse/visitor';
import { issueCsrfToken } from '@/lib/security/csrf';
import { isPublicVotingEnabled } from '@/lib/env';
import { turnstileSiteKey } from '@/lib/antiabuse/turnstile';

const slug = Astro.params.slug;
if (!slug) return new Response('Not found', { status: 404 });
const data = await getRoundWithCandidates(slug);
if (!data) return new Response('Not found', { status: 404 });
const member = await currentMember(Astro.request);
if (data.round.audience === 'members' && !member) return Astro.redirect('/miembros/ingresar?status=required');
const publicEnabled = isPublicVotingEnabled() && data.round.audience === 'members_and_public';
const turnstileKey = turnstileSiteKey();
const visitor = data.round.audience === 'members_and_public' ? await visitorIdentity(Astro.request) : null;
if (visitor?.setCookie) Astro.response.headers.append('Set-Cookie', visitor.setCookie);
const voterKey = visitor ? await visitor.voterKeyForRound(data.round.id) : null;
const selectedMovieId = member ? await getMemberVote(data.round.id, member.id) : voterKey ? await getPublicVote(data.round.id, voterKey) : null;
const showResults = Boolean(data.round.resultsPublishedAt);
const counts = showResults ? await getVoteCounts(data.round.id) : new Map();
const csrf = await issueCsrfToken(`round-vote:${data.round.id}`);
const now = Math.floor(Date.now() / 1000);
const open = isRoundOpen(data.round, now);
const date = new Intl.DateTimeFormat('es-PE', { dateStyle: 'full', timeStyle: 'short', timeZone: 'America/Lima' });
const status = Astro.url.searchParams.get('status');
---
<BaseLayout title={`${data.round.title} · CCFV`} description={data.round.description || 'Votación del Cine Club Federico Villarreal.'}>
  <section class="editorial-container py-16 lg:py-24">
    <div class="max-w-3xl">
      <a class="focus-ring editorial-link text-sm text-[var(--muted)]" href="/">← Ver otras rondas</a>
      <div class="mt-10 flex flex-wrap items-center gap-4"><span class="border border-[var(--ink)] px-3 py-1 text-xs font-bold uppercase tracking-[.1em]">{data.round.audience === 'members_and_public' ? 'CCFV + público' : 'Solo miembros'}</span><span class="text-xs uppercase tracking-[.08em] text-[var(--muted)]">{open ? `Cierra ${date.format(new Date(data.round.endsAt * 1000))}` : data.round.status === 'closed' ? 'Votación cerrada' : `Inicia ${date.format(new Date(data.round.startsAt * 1000))}`}</span></div>
      <h1 class="mt-7 max-w-4xl text-4xl font-normal leading-[1.05] tracking-[-.04em] text-[var(--ink)] sm:text-6xl">{data.round.title}</h1>
      {data.round.description && <p class="mt-7 max-w-2xl text-xl leading-8 text-[var(--muted)]">{data.round.description}</p>}
    </div>
    {status === 'saved' && <p class="mt-10 border-y border-[var(--ink)] px-1 py-4 text-sm font-medium text-[var(--ink)]">Tu elección quedó guardada. Puedes cambiarla mientras la ronda esté abierta.</p>}
    {status === 'closed' && <p class="mt-10 border-y border-[var(--line)] px-1 py-4 text-sm text-[var(--muted)]">La ronda ya está cerrada y no acepta cambios.</p>}
    {status === 'invalid' && <p class="mt-10 border-y border-[#a66a62] px-1 py-4 text-sm text-[#923d34]">No pudimos guardar esa elección. Actualiza la página e inténtalo de nuevo.</p>}
    <form class="mt-10" method="post" action={`/api/rounds/${data.round.id}/vote`}>
      <input type="hidden" name="csrf" value={csrf} />
      <fieldset disabled={!open || (!member && !publicEnabled)}>
        <legend class="sr-only">Elige una película</legend>
        <div class="grid gap-5 md:grid-cols-2">{data.candidates.map((movie) => <label class="block cursor-pointer"><input class="peer sr-only" type="radio" name="movieId" value={movie.id} checked={selectedMovieId === movie.id} required /><div class="transition peer-checked:scale-[1.01] peer-focus-visible:ring-4 peer-focus-visible:ring-[var(--gold)]/40"><MovieCard movie={movie} selected={selectedMovieId === movie.id} count={showResults ? counts.get(movie.id) : undefined} disabled={!open} /></div></label>)}</div>
        {publicEnabled && !member && turnstileKey && <div class="mt-6"><div class="cf-turnstile" data-sitekey={turnstileKey} data-action="public-vote"></div></div>}
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center"><button class="focus-ring editorial-action disabled:cursor-not-allowed disabled:opacity-40" type="submit">{selectedMovieId ? 'Cambiar mi voto' : 'Votar por esta selección'}</button><span class="text-sm text-[var(--muted)]">{member ? 'Estás votando como miembro CCFV.' : publicEnabled ? 'Voto público: una participación por navegador y ronda.' : 'La votación pública aún no está habilitada.'}</span></div>
      </fieldset>
    </form>
    {showResults && <section class="editorial-panel mt-16 border-x-0 border-b-0 p-6"><h2 class="text-2xl font-normal text-[var(--ink)]">Resultados publicados</h2><p class="mt-3 text-sm text-[var(--muted)]">Las señales se muestran por separado para que el equipo pueda interpretarlas.</p></section>}
  </section>
</BaseLayout>
{publicEnabled && !member && turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
