---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RoundCard from '@/components/RoundCard.astro';
import { listPublicRounds } from '@/lib/db/repositories';
import type { RoundSummary } from '@/lib/types';

let rounds: RoundSummary[] = [];
let dataError = false;
try {
  rounds = await listPublicRounds();
} catch {
  dataError = true;
}
---
<BaseLayout>
  <section class="editorial-container pb-12 pt-20 lg:pb-20 lg:pt-32">
    <div class="max-w-4xl">
      <p class="editorial-kicker">Cine Club Federico Villarreal</p>
      <h1 class="editorial-display mt-6">Elegimos juntos la próxima película.</h1>
      <p class="mt-8 max-w-2xl text-xl leading-8 text-[var(--muted)]">Propuestas del CCFV, rondas de votación y una señal clara de lo que quiere ver nuestra comunidad.</p>
    </div>
    <div class="mt-24 border-t border-[var(--ink)] pt-6 sm:mt-32">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div><p class="editorial-kicker">Ahora</p><h2 class="mt-3 text-3xl font-normal tracking-tight text-[var(--ink)]">Rondas abiertas al público</h2></div>
        <a class="focus-ring editorial-link text-sm font-bold uppercase tracking-[.08em]" href="/miembros/ingresar">Proponer una película →</a>
      </div>
    </div>
    {dataError ? <div class="editorial-panel mt-6 border-x-0 border-b-0 p-6 text-sm text-[var(--muted)]">La base de datos todavía no está conectada. Ejecuta las migraciones de D1 para publicar la primera ronda.</div> : rounds.length === 0 ? <div class="editorial-panel mt-6 border-x-0 border-b-0 p-8 text-center text-[var(--muted)]">Aún no hay rondas públicas. Vuelve pronto.</div> : <div class="mt-6 grid gap-0 md:grid-cols-2 md:gap-x-8">{rounds.map((round) => <RoundCard round={round} />)}</div>}
  </section>
</BaseLayout>
