---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RoundCard from '@/components/RoundCard.astro';
import { currentMember } from '@/lib/auth/member';
import { listMemberRounds } from '@/lib/db/repositories';
import { issueCsrfToken } from '@/lib/security/csrf';
import type { RoundSummary } from '@/lib/types';

const member = await currentMember(Astro.request);
if (!member) return Astro.redirect('/miembros/ingresar?status=expired');
const logoutCsrf = await issueCsrfToken('member-logout');
let rounds: RoundSummary[] = [];
try { rounds = await listMemberRounds(); } catch { rounds = []; }
---
<BaseLayout title="Área de miembros · CCFV">
  <section class="editorial-container py-16 lg:py-24">
    <div class="flex flex-col gap-6 border-b border-[var(--line)] pb-8 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="editorial-kicker">Área de miembros</p><h1 class="mt-4 text-4xl font-normal tracking-tight text-[var(--ink)] sm:text-5xl">Hola, {member.displayName}.</h1><p class="mt-4 max-w-xl text-[var(--muted)]">Aquí puedes proponer una película y votar en las rondas del club.</p></div>
      <div class="flex flex-wrap gap-3"><a class="focus-ring editorial-action" href="/miembros/proponer">Proponer película</a><form method="post" action="/api/members/logout"><input type="hidden" name="csrf" value={logoutCsrf} /><button class="focus-ring editorial-link px-1 py-2 text-xs font-bold uppercase tracking-[.1em] text-[var(--muted)]" type="submit">Salir</button></form></div>
    </div>
    <div class="mt-12 grid gap-0 md:grid-cols-2 md:gap-x-8">{rounds.map((round) => <RoundCard round={round} />)}</div>
    {rounds.length === 0 && <div class="editorial-panel mt-8 border-x-0 border-b-0 p-8 text-center text-[var(--muted)]">Todavía no hay rondas para votar.</div>}
    <p class="mt-10 text-sm"><a class="editorial-link text-xs font-bold uppercase tracking-[.1em] text-[var(--muted)]" href="/miembros/propuestas">Ver mis propuestas</a></p>
  </section>
</BaseLayout>
