---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RoundCard from '@/components/RoundCard.astro';
import { currentMember } from '@/lib/auth/member';
import { listMemberRounds } from '@/lib/db/repositories';
import { issueCsrfToken } from '@/lib/security/csrf';
import type { RoundSummary } from '@/lib/types';

const member = await currentMember(Astro.request);
if (!member) return Astro.redirect('/miembros/ingresar?status=expired');
const logoutCsrf = await issueCsrfToken('member-logout');
let rounds: RoundSummary[] = [];
try { rounds = await listMemberRounds(); } catch { rounds = []; }
---
<BaseLayout title="Área de miembros · CCFV">
  <section class="mx-auto max-w-6xl px-5 py-14 lg:px-8 lg:py-20">
    <div class="flex flex-col gap-6 border-b border-[var(--line)] pb-8 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="text-sm font-semibold uppercase tracking-[.16em] text-[var(--gold)]">Área de miembros</p><h1 class="mt-3 text-4xl font-black text-[var(--green)]">Hola, {member.displayName}.</h1><p class="mt-3 text-[var(--muted)]">Aquí puedes proponer una película y votar en las rondas del club.</p></div>
      <div class="flex flex-wrap gap-3"><a class="focus-ring rounded-xl bg-[var(--green)] px-4 py-3 text-sm font-semibold text-white" href="/miembros/proponer">Proponer película</a><form method="post" action="/api/members/logout"><input type="hidden" name="csrf" value={logoutCsrf} /><button class="focus-ring rounded-xl border border-[var(--line)] bg-[var(--paper)] px-4 py-3 text-sm font-semibold text-[var(--muted)]" type="submit">Salir</button></form></div>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-2">{rounds.map((round) => <RoundCard round={round} />)}</div>
    {rounds.length === 0 && <div class="mt-8 rounded-2xl border border-dashed border-[var(--line)] bg-[var(--paper)] p-8 text-center text-[var(--muted)]">Todavía no hay rondas para votar.</div>}
    <p class="mt-8 text-sm"><a class="text-[var(--green)] underline underline-offset-4" href="/miembros/propuestas">Ver mis propuestas</a></p>
  </section>
</BaseLayout>
