---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { currentMember } from '@/lib/auth/member';
import { issueCsrfToken } from '@/lib/security/csrf';

const member = await currentMember(Astro.request);
if (!member) return Astro.redirect('/miembros/ingresar?status=expired');
const csrf = await issueCsrfToken('member-proposal');
const status = Astro.url.searchParams.get('status');
---
<BaseLayout title="Proponer una película · CCFV">
  <section class="mx-auto max-w-3xl px-5 py-14 lg:px-8 lg:py-20">
    <a class="focus-ring text-sm text-[var(--muted)] underline underline-offset-4" href="/miembros">← Área de miembros</a>
    <h1 class="mt-6 text-4xl font-black text-[var(--green)]">Propón una película</h1>
    <p class="mt-4 max-w-2xl leading-7 text-[var(--muted)]">Pega un enlace de IMDb. Consultaremos TMDB para mostrarte la ficha y confirmar que es la película correcta antes de enviarla a revisión.</p>
    {status === 'duplicate' && <p class="mt-6 rounded-xl bg-[#fff8e8] px-4 py-3 text-sm text-[#805d1c]">Esa película ya tiene una propuesta registrada.</p>}
    {status === 'created' && <p class="mt-6 rounded-xl bg-[#e7f1e3] px-4 py-3 text-sm text-[var(--green)]">Tu propuesta quedó pendiente de revisión.</p>}
    <form class="mt-8 space-y-6 rounded-3xl border border-[var(--line)] bg-[var(--paper)] p-6 shadow-sm sm:p-8" method="post" action="/api/members/proposals">
      <input type="hidden" name="csrf" value={csrf} />
      <label class="block text-sm font-semibold" for="imdbUrl">Enlace IMDb</label>
      <input class="focus-ring w-full rounded-xl border border-[var(--line)] bg-white px-4 py-3" id="imdbUrl" name="imdbUrl" type="url" placeholder="https://www.imdb.com/title/tt0156887/" required />
      <label class="block text-sm font-semibold" for="justification">¿Por qué te gustaría verla? <span class="font-normal text-[var(--muted)]">(opcional)</span></label>
      <textarea class="focus-ring min-h-32 w-full resize-y rounded-xl border border-[var(--line)] bg-white px-4 py-3" id="justification" name="justification" maxlength="500" placeholder="Una breve razón para compartir con el equipo organizador."></textarea>
      <button class="focus-ring rounded-xl bg-[var(--green)] px-5 py-3.5 font-semibold text-white hover:bg-[#1e4633]" type="submit">Buscar y enviar propuesta</button>
      <p class="text-xs leading-5 text-[var(--muted)]">No usamos scraping de IMDb: solo extraemos el ID del enlace y consultamos la API de TMDB.</p>
    </form>
  </section>
</BaseLayout>
