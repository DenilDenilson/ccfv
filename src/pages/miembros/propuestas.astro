---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MoviePoster from '@/components/MoviePoster.astro';
import { currentMember } from '@/lib/auth/member';
import { listMemberProposals } from '@/lib/db/repositories';

const member = await currentMember(Astro.request);
if (!member) return Astro.redirect('/miembros/ingresar?status=expired');
const proposals = await listMemberProposals(member.id);
---
<BaseLayout title="Mis propuestas · CCFV">
  <section class="editorial-container max-w-4xl py-16 lg:py-24">
    <a class="focus-ring editorial-link text-sm text-[var(--muted)]" href="/miembros">← Área de miembros</a>
    <h1 class="mt-7 text-4xl font-normal tracking-tight text-[var(--ink)] sm:text-5xl">Mis propuestas</h1>
    <div class="editorial-panel mt-12 overflow-hidden border-x-0 border-b-0">
      {proposals.length === 0 ? <p class="p-7 text-[var(--muted)]">Todavía no has propuesto una película.</p> : <div class="divide-y divide-[var(--line)]">{proposals.map((proposal) => <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between"><div class="flex min-w-0 gap-4"><MoviePoster path={proposal.posterPath} alt={`Póster de ${proposal.title}`} class="h-28 w-20" /><div><h2 class="font-semibold text-[var(--ink)]">{proposal.title}</h2><p class="mt-1 text-xs uppercase tracking-[.08em] text-[var(--muted)]">{proposal.roundTitle || 'Propuesta antigua sin ronda'}</p>{proposal.justification && <p class="mt-1 text-sm text-[var(--muted)]">{proposal.justification}</p>}</div></div><span class="w-fit rounded-full bg-[#f0eee8] px-3 py-1 text-xs font-semibold capitalize text-[var(--muted)]">{proposal.status === 'pending' ? 'Pendiente' : proposal.status === 'approved' ? 'Aprobada' : 'Rechazada'}</span></div>)}</div>}
    </div>
  </section>
</BaseLayout>
