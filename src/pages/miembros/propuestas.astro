---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { currentMember } from '@/lib/auth/member';
import { listMemberProposals } from '@/lib/db/repositories';

const member = await currentMember(Astro.request);
if (!member) return Astro.redirect('/miembros/ingresar?status=expired');
const proposals = await listMemberProposals(member.id);
---
<BaseLayout title="Mis propuestas · CCFV">
  <section class="mx-auto max-w-4xl px-5 py-14 lg:px-8 lg:py-20">
    <a class="focus-ring text-sm text-[var(--muted)] underline underline-offset-4" href="/miembros">← Área de miembros</a>
    <h1 class="mt-6 text-4xl font-black text-[var(--green)]">Mis propuestas</h1>
    <div class="mt-8 overflow-hidden rounded-2xl border border-[var(--line)] bg-[var(--paper)]">
      {proposals.length === 0 ? <p class="p-7 text-[var(--muted)]">Todavía no has propuesto una película.</p> : <div class="divide-y divide-[var(--line)]">{proposals.map((proposal) => <div class="flex flex-col gap-2 p-5 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="font-semibold text-[var(--ink)]">{proposal.title}</h2>{proposal.justification && <p class="mt-1 text-sm text-[var(--muted)]">{proposal.justification}</p>}</div><span class="w-fit rounded-full bg-[#f0eee8] px-3 py-1 text-xs font-semibold capitalize text-[var(--muted)]">{proposal.status === 'pending' ? 'Pendiente' : proposal.status === 'approved' ? 'Aprobada' : 'Rechazada'}</span></div>)}</div>}
    </div>
  </section>
</BaseLayout>
