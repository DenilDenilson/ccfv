---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { currentAdmin, listAdminMembers, listAdminRounds, listAdminScreenings, listApprovedProposals, listPendingProposals, listRoundCandidates, listRoundResults } from '@/lib/auth/admin';
import { issueCsrfToken } from '@/lib/security/csrf';

const admin = await currentAdmin(Astro.request);
if (!admin) return Astro.redirect('/admin/login');
const [proposals, approvedProposals, rounds, screenings, members] = await Promise.all([listPendingProposals(), listApprovedProposals(), listAdminRounds(), listAdminScreenings(), listAdminMembers()]);
const candidates = await Promise.all(rounds.map(async (round) => [round.id, await listRoundCandidates(round.id)] as const));
const candidatesByRound = new Map(candidates);
const results = await Promise.all(rounds.map(async (round) => [round.id, await listRoundResults(round.id)] as const));
const resultsByRound = new Map(results);
const reviewCsrf = await issueCsrfToken('admin-review');
const createRoundCsrf = await issueCsrfToken('admin-round-create');
const memberCsrf = await issueCsrfToken('admin-members');
const resolvedRoundCsrf = new Map(await Promise.all(rounds.map(async (round) => [round.id, await issueCsrfToken(`admin-round:${round.id}`)] as const)));
const resolvedScreeningCsrf = new Map(await Promise.all(screenings.map(async (screening) => [screening.id, await issueCsrfToken(`admin-screening:${screening.id}`)] as const)));
const screeningByMovie = new Map(screenings.filter((screening) => screening.round_id).map((screening) => [`${screening.round_id}:${screening.movie_id}`, screening]));
---
<BaseLayout title="Administración · CCFV">
  <section class="mx-auto max-w-7xl px-5 py-12 lg:px-8 lg:py-16">
    <div class="flex flex-col gap-3 border-b border-[var(--line)] pb-8 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="text-sm font-semibold uppercase tracking-[.16em] text-[var(--gold)]">Panel administrativo</p><h1 class="mt-3 text-4xl font-black text-[var(--green)]">Organiza las próximas funciones.</h1></div>
      <div class="flex items-center gap-4"><span class="text-sm text-[var(--muted)]">{admin.displayName}</span><form method="post" action="/api/admin/local-logout"><button class="text-xs font-semibold text-[var(--muted)] underline underline-offset-4" type="submit">Salir</button></form></div>
    </div>
    <div class="mt-8 rounded-2xl border border-[var(--line)] bg-[var(--paper)] p-5 text-sm text-[var(--muted)]">Las operaciones administrativas se validan en el servidor. En entorno local, usa el encabezado <code class="text-[var(--ink)]">X-CCFV-Local-Admin</code> con el secreto configurado.</div>
    <section class="mt-8 rounded-2xl border border-[var(--line)] bg-[var(--paper)] p-5">
      <div class="flex items-end justify-between"><div><p class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--gold)]">Archivo operativo</p><h2 class="mt-2 text-2xl font-bold text-[var(--ink)]">Funciones programadas y proyectadas</h2></div><span class="text-sm text-[var(--muted)]">{screenings.length}</span></div>
      <div class="mt-4 grid gap-3 md:grid-cols-2">{screenings.length === 0 ? <p class="text-sm text-[var(--muted)]">Una película seleccionada aparecerá aquí para programar su función.</p> : screenings.map((screening) => { const token = resolvedScreeningCsrf.get(screening.id) || ''; return <article class="rounded-xl border border-[var(--line)] bg-white p-4"><div class="flex items-start justify-between gap-3"><div><h3 class="font-bold text-[var(--green)]">{screening.movie_title}</h3><p class="mt-1 text-xs text-[var(--muted)]">{new Date(screening.scheduled_at * 1000).toLocaleString('es-PE')}{screening.venue ? ` · ${screening.venue}` : ''}</p></div><span class="text-xs capitalize text-[var(--muted)]">{screening.status}</span></div>{screening.status === 'scheduled' && <div class="mt-3 flex gap-2"><form method="post" action={`/api/admin/screenings/${screening.id}/screened`}><input type="hidden" name="csrf" value={token} /><button class="rounded-lg bg-[var(--green)] px-3 py-2 text-xs font-semibold text-white" type="submit">Marcar proyectada</button></form><form method="post" action={`/api/admin/screenings/${screening.id}/cancel`}><input type="hidden" name="csrf" value={token} /><input type="hidden" name="reason" value="Cancelada por administración." /><button class="rounded-lg border border-[var(--line)] px-3 py-2 text-xs font-semibold text-[var(--muted)]" type="submit">Cancelar</button></form></div>}</article> })}</div>
    </section>
    <section class="mt-8 rounded-2xl border border-[var(--line)] bg-[var(--paper)] p-5">
      <div class="flex items-end justify-between"><div><p class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--gold)]">Miembros</p><h2 class="mt-2 text-2xl font-bold text-[var(--ink)]">Códigos de acceso</h2></div><span class="text-sm text-[var(--muted)]">{members.length}</span></div>
      <form class="mt-4 flex flex-col gap-2 sm:flex-row" method="post" action="/api/admin/members/create" data-member-json><input type="hidden" name="csrf" value={memberCsrf} /><input required minlength="2" maxlength="120" name="displayName" class="flex-1 rounded-lg border border-[var(--line)] bg-white px-3 py-2 text-sm" placeholder="Nombre del miembro" /><button class="rounded-lg bg-[var(--green)] px-4 py-2 text-sm font-semibold text-white" type="submit">Crear código</button></form>
      <div id="member-code-result" class="mt-3 hidden rounded-lg bg-[#fff8e8] p-3 text-sm text-[#805d1c]" role="status"></div>
      <div class="mt-5 grid gap-2 md:grid-cols-2">{members.map((member) => <div class="flex items-center justify-between gap-3 rounded-lg border border-[var(--line)] bg-white px-3 py-3"><div><p class="text-sm font-semibold text-[var(--ink)]">{member.display_name}</p><p class="text-xs capitalize text-[var(--muted)]">{member.status}</p></div>{member.status === 'active' && <div class="flex gap-2"><form method="post" action="/api/admin/members/rotate" data-member-json><input type="hidden" name="csrf" value={memberCsrf} /><input type="hidden" name="memberId" value={member.id} /><button class="rounded-lg border border-[var(--line)] px-2 py-2 text-xs font-semibold text-[var(--muted)]" type="submit">Regenerar</button></form><form method="post" action="/api/admin/members/disable"><input type="hidden" name="csrf" value={memberCsrf} /><input type="hidden" name="memberId" value={member.id} /><button class="rounded-lg border border-[#e3b3ad] px-2 py-2 text-xs font-semibold text-[#923d34]" type="submit">Desactivar</button></form></div>}</div>)}</div>
    </section>

    <div class="mt-10 grid gap-8 xl:grid-cols-[1.15fr_.85fr]">
      <section>
        <div class="flex items-end justify-between"><div><p class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--gold)]">Revisión</p><h2 class="mt-2 text-2xl font-bold text-[var(--ink)]">Propuestas pendientes</h2></div><span class="text-sm text-[var(--muted)]">{proposals.length}</span></div>
        <div class="mt-5 space-y-3">
          {proposals.length === 0 ? <div class="rounded-2xl border border-dashed border-[var(--line)] bg-[var(--paper)] p-6 text-[var(--muted)]">No hay propuestas pendientes.</div> : proposals.map((proposal) => <article class="rounded-2xl border border-[var(--line)] bg-[var(--paper)] p-5"><div class="flex items-start justify-between gap-4"><div><h3 class="font-bold text-[var(--green)]">{proposal.title}</h3><p class="mt-1 text-xs text-[var(--muted)]">Propuesta de {proposal.proposer}{proposal.release_year ? ` · ${proposal.release_year}` : ''}</p></div><span class="text-xs text-[var(--muted)]">{new Date(proposal.created_at * 1000).toLocaleDateString('es-PE')}</span></div>{proposal.justification && <p class="mt-4 text-sm leading-6 text-[var(--muted)]">{proposal.justification}</p>}<div class="mt-5 flex gap-2"><form method="post" action="/api/admin/proposals/review"><input type="hidden" name="csrf" value={reviewCsrf} /><input type="hidden" name="proposalId" value={proposal.id} /><input type="hidden" name="decision" value="approved" /><button class="focus-ring rounded-lg bg-[var(--green)] px-3 py-2 text-xs font-semibold text-white" type="submit">Aprobar</button></form><form method="post" action="/api/admin/proposals/review"><input type="hidden" name="csrf" value={reviewCsrf} /><input type="hidden" name="proposalId" value={proposal.id} /><input type="hidden" name="decision" value="rejected" /><button class="focus-ring rounded-lg border border-[var(--line)] px-3 py-2 text-xs font-semibold text-[var(--muted)]" type="submit">Rechazar</button></form></div></article>)}
        </div>

        <div class="mt-10 rounded-2xl border border-[var(--line)] bg-[var(--paper)] p-5">
          <p class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--gold)]">Nueva ronda</p><h2 class="mt-2 text-2xl font-bold text-[var(--ink)]">Crear una votación</h2>
          <form class="mt-5 grid gap-4 sm:grid-cols-2" method="post" action="/api/admin/rounds/create">
            <input type="hidden" name="csrf" value={createRoundCsrf} />
            <label class="text-sm font-semibold text-[var(--ink)]">Título<input required maxlength="120" name="title" class="mt-2 w-full rounded-lg border border-[var(--line)] bg-white px-3 py-2 font-normal" placeholder="Especial Halloween" /></label>
            <label class="text-sm font-semibold text-[var(--ink)]">Slug<input required maxlength="80" pattern="[a-zA-Z0-9-]+" name="slug" class="mt-2 w-full rounded-lg border border-[var(--line)] bg-white px-3 py-2 font-normal" placeholder="especial-halloween" /></label>
            <label class="text-sm font-semibold text-[var(--ink)] sm:col-span-2">Descripción<textarea maxlength="500" name="description" class="mt-2 min-h-20 w-full rounded-lg border border-[var(--line)] bg-white px-3 py-2 font-normal" placeholder="Contexto de la ronda"></textarea></label>
            <label class="text-sm font-semibold text-[var(--ink)]">Inicio<input required type="datetime-local" name="startsAt" class="mt-2 w-full rounded-lg border border-[var(--line)] bg-white px-3 py-2 font-normal" /></label>
            <label class="text-sm font-semibold text-[var(--ink)]">Cierre<input required type="datetime-local" name="endsAt" class="mt-2 w-full rounded-lg border border-[var(--line)] bg-white px-3 py-2 font-normal" /></label>
            <label class="text-sm font-semibold text-[var(--ink)] sm:col-span-2">Audiencia<select name="audience" class="mt-2 w-full rounded-lg border border-[var(--line)] bg-white px-3 py-2 font-normal"><option value="members_and_public">Miembros y público</option><option value="members">Solo miembros</option></select></label>
            <button class="focus-ring rounded-lg bg-[var(--green)] px-4 py-3 text-sm font-semibold text-white sm:col-span-2" type="submit">Guardar ronda como borrador</button>
          </form>
        </div>
      </section>

      <section>
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--gold)]">Rondas</p><h2 class="mt-2 text-2xl font-bold text-[var(--ink)]">Estado del calendario</h2>
        <div class="mt-5 space-y-4">
          {rounds.length === 0 ? <div class="rounded-2xl border border-dashed border-[var(--line)] bg-[var(--paper)] p-6 text-[var(--muted)]">Crea la primera ronda para comenzar.</div> : rounds.map((round) => { const roundToken = resolvedRoundCsrf.get(round.id) || ''; const roundCandidates = candidatesByRound.get(round.id) || []; const roundResults = resultsByRound.get(round.id) || []; return <article class="rounded-2xl border border-[var(--line)] bg-[var(--paper)] p-5"><div class="flex items-start justify-between gap-4"><div><a class="font-bold text-[var(--green)] hover:underline" href={`/rondas/${round.slug}`}>{round.title}</a><p class="mt-1 text-xs text-[var(--muted)]">{round.candidate_count} candidatas · {round.audience === 'members_and_public' ? 'público' : 'miembros'} · {new Date(round.starts_at * 1000).toLocaleDateString('es-PE')}</p></div><span class="text-xs capitalize text-[var(--muted)]">{round.status}</span></div>
            <div class="mt-4 space-y-2">{roundCandidates.map((candidate) => { const screening = screeningByMovie.get(`${round.id}:${candidate.movie_id}`); return <div class="rounded-lg bg-white px-3 py-2 text-sm"><div class="flex items-center justify-between gap-3"><span class="text-[var(--ink)]">{candidate.title}{candidate.release_year ? ` (${candidate.release_year})` : ''}</span>{candidate.selected_at && <span class="text-xs font-semibold text-[var(--gold)]">Seleccionada</span>}</div>{candidate.selected_at && !screening && <form class="mt-3 grid gap-2 sm:grid-cols-[1fr_1fr_auto]" method="post" action="/api/admin/screenings/schedule"><input type="hidden" name="csrf" value={roundToken} /><input type="hidden" name="roundId" value={round.id} /><input type="hidden" name="movieId" value={candidate.movie_id} /><input required type="datetime-local" name="scheduledAt" class="rounded-lg border border-[var(--line)] px-2 py-2 text-xs" /><input name="venue" class="rounded-lg border border-[var(--line)] px-2 py-2 text-xs" placeholder="Lugar" /><button class="rounded-lg bg-[var(--green)] px-2 py-2 text-xs font-semibold text-white" type="submit">Programar</button></form>}</div> })}</div>
            {roundResults.length > 0 && <div class="mt-5 rounded-xl border border-[var(--line)] bg-white p-4"><div class="flex items-center justify-between"><h3 class="text-sm font-bold text-[var(--green)]">Resultados separados</h3><span class="text-xs text-[var(--muted)]">{round.results_published_at ? 'Publicados' : 'Internos'}</span></div><div class="mt-3 space-y-2">{roundResults.map((result) => <div class="grid grid-cols-[1fr_auto_auto] gap-3 text-xs"><span class="text-[var(--ink)]">{result.title}</span><span class="text-[var(--muted)]">Miembros: <strong class="text-[var(--ink)]">{result.member_count}</strong></span><span class="text-[var(--muted)]">Público: <strong class="text-[var(--ink)]">{result.public_counted_count}</strong></span></div>)}</div>{!round.results_published_at && <form class="mt-3" method="post" action={`/api/admin/rounds/${round.id}/publish-results`}><input type="hidden" name="csrf" value={roundToken} /><button class="rounded-lg border border-[var(--green)] px-3 py-2 text-xs font-semibold text-[var(--green)]" type="submit">Publicar resultados</button></form>}</div>}
            {round.status === 'draft' && <><form class="mt-4 grid gap-2 sm:grid-cols-[1fr_5rem_auto]" method="post" action="/api/admin/rounds/add-candidate"><input type="hidden" name="csrf" value={roundToken} /><input type="hidden" name="roundId" value={round.id} /><select required name="proposalId" class="rounded-lg border border-[var(--line)] bg-white px-3 py-2 text-sm"><option value="">Añadir propuesta aprobada…</option>{approvedProposals.map((proposal) => <option value={proposal.id}>{proposal.title}{proposal.release_year ? ` (${proposal.release_year})` : ''}</option>)}</select><input required type="number" min="1" max="99" name="position" value={round.candidate_count + 1} class="rounded-lg border border-[var(--line)] bg-white px-3 py-2 text-sm" /><button class="rounded-lg border border-[var(--green)] px-3 py-2 text-xs font-semibold text-[var(--green)]" type="submit">Añadir</button></form><form class="mt-3" method="post" action="/api/admin/rounds/publish"><input type="hidden" name="csrf" value={roundToken} /><input type="hidden" name="roundId" value={round.id} /><button class="rounded-lg bg-[var(--green)] px-3 py-2 text-xs font-semibold text-white" type="submit">Abrir votación</button></form></>}
            {round.status === 'published' && <form class="mt-3" method="post" action="/api/admin/rounds/close"><input type="hidden" name="csrf" value={roundToken} /><input type="hidden" name="roundId" value={round.id} /><button class="rounded-lg border border-[var(--line)] px-3 py-2 text-xs font-semibold text-[var(--ink)]" type="submit">Cerrar votación</button></form>}
            {round.status === 'closed' && <div class="mt-3 flex flex-wrap gap-2"><form method="post" action={`/api/admin/rounds/${round.id}/finalize`}><input type="hidden" name="csrf" value={roundToken} /><button class="rounded-lg bg-[var(--green)] px-3 py-2 text-xs font-semibold text-white" type="submit">Finalizar resultados</button></form>{roundCandidates.filter((candidate) => !candidate.selected_at).map((candidate) => <form method="post" action={`/api/admin/rounds/${round.id}/select`}><input type="hidden" name="csrf" value={roundToken} /><input type="hidden" name="movieId" value={candidate.movie_id} /><input type="hidden" name="reason" value="Selección administrativa tras revisar los resultados." /><button class="rounded-lg border border-[var(--line)] px-3 py-2 text-xs font-semibold text-[var(--ink)]" type="submit">Seleccionar {candidate.title}</button></form>)}</div>}
          </article> })}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-member-json]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const result = document.querySelector<HTMLElement>('#member-code-result');
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await response.json() as { code?: string; message?: string; error?: string };
        if (!response.ok || !data.code) throw new Error(data.error || 'No se pudo completar la operación.');
        if (result) { result.textContent = `${data.message || 'Código generado'} ${data.code}`; result.classList.remove('hidden'); }
        if (form.getAttribute('action')?.endsWith('/create')) form.reset();
      } catch (error) {
        if (result) { result.textContent = error instanceof Error ? error.message : 'No se pudo completar la operación.'; result.classList.remove('hidden'); }
      }
    });
  });
</script>
