---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { runtimeEnv } from '@/lib/env';

if (runtimeEnv().APP_ENV !== 'local') return new Response('Admin access is protected by Cloudflare Access.', { status: 403 });
---
<BaseLayout title="Acceso local · CCFV">
  <section class="mx-auto max-w-md px-5 py-20">
    <p class="text-sm font-semibold uppercase tracking-[.16em] text-[var(--gold)]">Entorno local</p>
    <h1 class="mt-3 text-4xl font-black text-[var(--green)]">Acceso administrativo</h1>
    <p class="mt-4 text-sm leading-6 text-[var(--muted)]">Introduce el secreto local definido en <code>.dev.vars</code>. Este acceso solo funciona con <code>APP_ENV=local</code>.</p>
    <form class="mt-8 rounded-2xl border border-[var(--line)] bg-[var(--paper)] p-5" method="post" action="/api/admin/local-login">
      <label class="text-sm font-semibold text-[var(--ink)]">Secreto local<input required type="password" name="secret" autocomplete="current-password" class="mt-2 w-full rounded-lg border border-[var(--line)] bg-white px-3 py-3" /></label>
      <button class="mt-5 w-full rounded-lg bg-[var(--green)] px-4 py-3 text-sm font-semibold text-white" type="submit">Entrar al panel</button>
    </form>
  </section>
</BaseLayout>
