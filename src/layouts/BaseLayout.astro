---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'CCFV — Cine Club Federico Villarreal', description = 'Propuestas y votaciones para las próximas funciones del CCFV.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen paper-grid">
    <header class="editorial-header">
      <div class="editorial-container flex flex-col gap-4 py-6 sm:flex-row sm:items-center sm:justify-between">
        <a class="focus-ring editorial-link text-base font-normal uppercase tracking-[.12em]" href="/">Cine Club CCFV</a>
        <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-bold uppercase tracking-[.12em] text-[var(--muted)]">
          <a class="focus-ring editorial-link" href="/">Inicio</a>
          <a class="focus-ring editorial-link" href="/miembros/ingresar">Área de miembros</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="editorial-container mt-24 border-t border-[var(--ink)] py-8 text-xs uppercase tracking-[.08em] text-[var(--muted)]">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <span>CCFV · Cine y conversación desde Villarreal.</span>
        <span>Datos de películas: TMDB.</span>
      </div>
    </footer>
  </body>
</html>
