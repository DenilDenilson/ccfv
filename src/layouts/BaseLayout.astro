---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'CCFV — Cine Club Federico Villarreal', description = 'Propuestas y votaciones para las próximas funciones del CCFV.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen paper-grid">
    <header class="border-b border-[var(--line)] bg-[var(--paper)]/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 lg:px-8">
        <a class="focus-ring flex items-center gap-3 rounded-xl" href="/">
          <span class="grid size-10 place-items-center rounded-full bg-[var(--green)] text-sm font-black tracking-tight text-white">CCFV</span>
          <span class="hidden text-sm font-semibold tracking-wide text-[var(--green)] sm:block">Cine Club Federico Villarreal</span>
        </a>
        <nav class="flex items-center gap-2 text-sm text-[var(--muted)]">
          <a class="focus-ring rounded-lg px-3 py-2 hover:bg-[#eef2e9] hover:text-[var(--green)]" href="/miembros/ingresar">Soy miembro</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mx-auto mt-20 max-w-6xl border-t border-[var(--line)] px-5 py-8 text-xs text-[var(--muted)] lg:px-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <span>CCFV · Cine y conversación desde Villarreal.</span>
        <span>Los datos de películas provienen de TMDB.</span>
      </div>
    </footer>
  </body>
</html>
