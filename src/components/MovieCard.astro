---
import type { Candidate } from '@/lib/types';
import { posterUrl } from '@/lib/tmdb';

interface Props {
  movie: Candidate;
  selected?: boolean;
  count?: { member: number; public: number };
  disabled?: boolean;
}

const { movie, selected = false, count, disabled = false } = Astro.props;
const poster = posterUrl(movie.posterPath);
---
<article aria-disabled={disabled} class={`group overflow-hidden rounded-2xl border bg-[var(--paper)] shadow-sm transition ${disabled ? 'opacity-70' : ''} ${selected ? 'border-[var(--green)] ring-2 ring-[var(--green)]/15' : 'border-[var(--line)] hover:-translate-y-0.5 hover:shadow-md'}`}>
  <div class="grid grid-cols-[88px_1fr] gap-4 p-4 sm:grid-cols-[112px_1fr]">
    <div class="aspect-[2/3] overflow-hidden rounded-xl bg-[#e7e7df]">
      {poster ? <img class="h-full w-full object-cover" src={poster} alt={`Póster de ${movie.title}`} loading="lazy" /> : <div class="grid h-full place-items-center p-3 text-center text-xs text-[var(--muted)]">Póster no disponible</div>}
    </div>
    <div class="flex min-w-0 flex-col">
      <p class="mb-1 text-xs font-semibold uppercase tracking-[.14em] text-[var(--gold)]">Candidata {movie.position}</p>
      <h2 class="text-lg font-bold leading-tight text-[var(--green)]">{movie.title}</h2>
      <p class="mt-1 text-xs text-[var(--muted)]">{movie.releaseYear ?? 'Año no disponible'}{movie.directors.length ? ` · ${movie.directors.join(', ')}` : ''}</p>
      {movie.overview && <p class="mt-3 line-clamp-4 text-sm leading-6 text-[var(--muted)]">{movie.overview}</p>}
      {movie.runtimeMinutes && <p class="mt-auto pt-3 text-xs text-[var(--muted)]">{movie.runtimeMinutes} min</p>}
      {count && <div class="mt-3 flex gap-3 border-t border-[var(--line)] pt-3 text-xs text-[var(--muted)]"><span>Miembros: <strong class="text-[var(--ink)]">{count.member}</strong></span><span>Público: <strong class="text-[var(--ink)]">{count.public}</strong></span></div>}
    </div>
  </div>
  {selected && <div class="bg-[#edf3e9] px-4 py-2 text-xs font-semibold text-[var(--green)]">Tu elección está guardada</div>}
</article>
